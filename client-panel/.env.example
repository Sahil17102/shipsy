VITE_API_URL=https://api.goshipsy.in/api
VITE_EMAIL_OTP_ENABLED=true
VITE_STATIC_DATA_ENABLED=true
VITE_R2_STORAGE_ENABLED=true

# Server-only values. Configure these on the VPS; never commit real secrets.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=sender@example.com
SMTP_PASS=replace-with-app-password
MAIL_FROM_NAME=ShipSy
MAIL_FROM_ADDRESS=sender@example.com
OTP_SECRET=replace-with-a-long-random-secret
# Server polls active courier shipments automatically. Minimum: 60000 (1 minute).
TRACKING_SYNC_INTERVAL_MS=300000
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-separate-admin-password
ADMIN_NAME=ShipSy Admin

# Cloudflare R2 (server-only). R2_PREFIX must remain isolated for this project.
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-with-r2-access-key
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-key
PROD_BUCKET=shipzilla-prod
R2_PREFIX=shipsy
PUBLIC_API_URL=https://api.goshipsy.in/api

# Direct FShip account (server-only). Copy the Client Key from FShip Settings > API Details.
FSHIP_API_URL=https://capi.fship.in
FSHIP_CLIENT_KEY=replace-with-fship-client-key

# Delivery connector account (server-only; obtains a short-lived Bearer token).
DELIVERY_API_URL=https://api.logixmitra.com/api
DELIVERY_API_EMAIL=replace-with-delivery-account-email
DELIVERY_API_PASSWORD=replace-with-delivery-account-password

# Razorpay (server-only). Never expose RAZORPAY_KEY_SECRET in the frontend.
RAZORPAY_KEY_ID=rzp_live_replace_with_key_id
RAZORPAY_KEY_SECRET=replace-with-live-key-secret
# Set this independently in the Razorpay Dashboard if you enable webhooks.
RAZORPAY_WEBHOOK_SECRET=replace-with-webhook-secret
